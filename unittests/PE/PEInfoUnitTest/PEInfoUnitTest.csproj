<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="CppMangledNameParserTests.cs" />
    <Compile Include="$(RepoRoot)src\CADShared\PE\PeInfo.cs" Link="PE\PeInfo.cs" />
    <Compile Include="$(RepoRoot)src\CADShared\PE\StringHelper.cs" Link="PE\StringHelper.cs" />
    <Compile Include="$(RepoRoot)src\CADShared\PE\CppMangledNameParser.cs" Link="PE\CppMangledNameParser.cs" />
    <Compile Include="$(RepoRoot)src\CADShared\PE\CppToCSharpMapper.cs" Link="PE\CppToCSharpMapper.cs" />
    <Compile Include="$(RepoRoot)src\CADShared\PE\DllImportGenerator.cs" Link="PE\DllImportGenerator.cs" />
  </ItemGroup>

</Project>
