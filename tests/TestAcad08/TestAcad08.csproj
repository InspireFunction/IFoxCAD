<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>

        <TargetFrameworks>NET35</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <PlatformTarget>x86</PlatformTarget>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

        <!-- 禁用资源生成，避免.NET Core MSBuild的ResGen错误 -->
        <GenerateResourceNeverGenerateTypeMetadata>true</GenerateResourceNeverGenerateTypeMetadata>
        <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>

        <!-- RuntimeHelpers 的重复警告 -->
        <NoWarn>CS8012;CS1685</NoWarn>
        <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

        <!-- 调试路径的变量 -->
        <cad08>C:\Program Files (x86)\AutoCAD 2008\</cad08>
    </PropertyGroup>



    <PropertyGroup Condition="'$(TargetFramework)' == 'NET35'">
        <DefineConstants>$(Configuration);acad;ac2008;ac2009</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!--<ProjectReference Include="$(RepoRoot)src\IFoxCAD.LoadForm\IFoxCAD.LoadEx.csproj" />-->
        <ProjectReference Include="$(RepoRoot)src\IFoxCAD.Acad08\IFoxCAD.Acad08.csproj" />
    </ItemGroup>

    <Import Project="$(RepoRoot)tests\TestShared\TestShared.projitems" Label="Shared" />

    <ItemGroup>
        <Compile Include="$(RepoRoot)tests\TestAcad09plus\GlobalUsings.cs" Link="\%(FileName)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(RepoRoot)tests\TestAcad09plus\拦截输入法\**\*.cs" Exclude="$(RepoRoot)tests\TestAcad09plus\拦截输入法\**\*xaml*.cs">
            <Link>拦截输入法\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>


    <!-- ============================================ -->
    <!-- 使用 PowerShell 脚本遍历注册表并注册所有 CAD 版本 -->
    <!-- 仅在 F5 调试时执行，生成/重新生成时不执行 -->
    <!-- ============================================ -->
    <Target Name="RegisterAcadPlugin" BeforeTargets="Build" Condition="'$(Configuration)'=='Debug'">
        <PropertyGroup>
            <!-- 将相对路径转换为完整路径 -->
            <DllPath>$([System.IO.Path]::GetFullPath('$(OutDir)$(AssemblyName).dll'))</DllPath>
            <ScriptPath>$(MSBuildProjectDirectory)\RegisterAcadPlugin.ps1</ScriptPath>
        </PropertyGroup>

        <Message Text="正在搜索并注册 AutoCAD 插件..." Importance="high" />
        <Message Text="DLL路径: $(DllPath)" Importance="high" />

        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScriptPath)&quot; -AppName &quot;$(AssemblyName)&quot; -DllPath &quot;$(DllPath)&quot;" ConsoleToMSBuild="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="RegOutput" />
        </Exec>
        <Message Text="$(RegOutput)" Importance="high" />
    </Target>

    <!-- 清理的时候卸载注册表 -->
    <Target Name="UnregisterAcadPlugin" AfterTargets="Clean">
        <PropertyGroup>
            <ScriptPath>$(MSBuildProjectDirectory)\UnregisterAcadPlugin.ps1</ScriptPath>
        </PropertyGroup>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScriptPath)&quot; -AppName &quot;$(AssemblyName)&quot;" ConsoleToMSBuild="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="UnregOutput" />
        </Exec>
        <Message Text="$(UnregOutput)" Importance="high" />
    </Target>
    <!-- ============================================ -->


</Project>
