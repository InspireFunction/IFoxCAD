<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--2009也是net35-->
        <TargetFrameworks>NET40;NET45</TargetFrameworks>
        <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
        <BuildInParallel>false</BuildInParallel>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>IFox.CAD.ACAD</PackageId>
        <Title>IFox.CAD.ACAD</Title>
        <Product>IFox.CAD.ACAD</Product>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>none</DebugType>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>none</DebugType>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <DocumentationFile>bin\Release\IFoxCAD.AutoCad.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'NET35'">
        <DefineConstants>$(Configuration);acad;ac2009</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'NET40'">
        <DefineConstants>$(Configuration);acad;ac2013</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'NET45'">
        <DefineConstants>$(Configuration);acad;ac2015</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'NET35'">
        <PackageReference Include="Autocad.NetApi" Version="17.2.0" ExcludeAssets="runtime" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'NET40'">
        <PackageReference Include="Autocad.NetApi" Version="19.0.0" ExcludeAssets="runtime" />
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'NET45'">
        <PackageReference Include="AutoCAD.NET" Version="20.0.1" ExcludeAssets="runtime" />
        <PackageReference Include="System.Collections" Version="4.3.0" />
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>

    <!-- 确保 IFoxFunKit 先编译 -->
    <Target Name="BuildIFoxFunKitFirst" BeforeTargets="BeforeBuild">
        <MSBuild Projects="$(RepoRoot)src\IFoxFunKit\IFoxFunKit.csproj"
                 Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
    </Target>

    <!--<ItemGroup>
      <PackageReference Include="IndexRange" Version="1.0.2"/>
    </ItemGroup>-->

</Project>